# ===== Réglages secrets de la page TikTok Elite =====
# Ce fichier devient /opt/creato/landing.env sur le serveur. Il ne va JAMAIS sur GitHub ni dans une conversation.
# Après une modification : ./deploy/landing.sh

# Clé API SasPay (tableau de bord SasPay → Développeur). sk_test_… pour essayer, sk_live_… pour les vrais paiements.
SASPAY_API_KEY=""

# Secret de signature du webhook SasPay (affiché UNE seule fois quand tu crées le webhook).
# Adresse du webhook à mettre dans SasPay : https://creatoskills.site/api/saspay/webhook  (événement : transaction.success)
SASPAY_WEBHOOK_SECRET=""

# Montant réellement facturé (chaîne avec 2 décimales) et devise.
SASPAY_AMOUNT="120.00"
SASPAY_CURRENCY="EUR"
SASPAY_DESCRIPTION="TikTok Elite"

# Code d'accès affiché après un paiement réussi, et page de la communauté.
ACCESS_CODE="3GS&JnQr"
COMMUNITY_URL="https://whop.com/meekyo/lien-d-acces-a-tiktok-elite/"

SITE_URL="https://creatoskills.site"
