# ===== Réglages secrets du site Creato =====
# Ce fichier devient /opt/creato-site/site.env sur le serveur. Il ne va JAMAIS sur GitHub ni dans une conversation.
# Après une modification : ./deploy/site.sh

DOMAIN="creatoskills.site"
SITE_URL="https://creatoskills.site"

# --- Carte bancaire : Maketou (boutique → Autres → Clés API) ---
MAKETOU_API_KEY=""

# --- Mobile money : SasPay ---
# Adresse du webhook à mettre dans SasPay : https://creatoskills.site/api/saspay/webhook (événement transaction.success)
SASPAY_API_KEY=""
SASPAY_WEBHOOK_SECRET=""
SASPAY_AMOUNT="120.00"
SASPAY_CURRENCY="EUR"
SASPAY_DESCRIPTION="TikTok Elite"

# --- Après un paiement confirmé : code d'accès affiché et lien pour rejoindre ---
ACCESS_CODE=""
COMMUNITY_URL=""
