# ===== Réglages secrets du site Creato =====
# Ce fichier devient /opt/creato-site/site.env sur le serveur. Il ne va JAMAIS sur GitHub ni dans une conversation.
# Après une modification : ./deploy/site.sh

DOMAIN="creatoskills.site"
SITE_URL="https://creatoskills.site"

# --- Carte bancaire : Maketou (boutique → Autres → Clés API) ---
MAKETOU_API_KEY=""

# --- Mobile money : SasPay ---
# Adresse du webhook à mettre dans SasPay : https://creatoskills.site/api/saspay/webhook (événement transaction.success)
SASPAY_API_KEY=""
SASPAY_WEBHOOK_SECRET=""
# Montant demandé à SasPay (hors frais). Le site affiche 120 € : avec les frais de SasPay, le client paie environ 120 €.
SASPAY_AMOUNT="115.00"
SASPAY_CURRENCY="EUR"
SASPAY_DESCRIPTION="TikTok Elite"

# --- Message privé Discord à chaque vente (facultatif) ---
# Jeton du bot Creato (repris automatiquement de /opt/creato/.env s'il existe).
DISCORD_BOT_TOKEN=""
# Ton identifiant Discord : Paramètres → Avancés → Mode développeur, puis clic droit sur ton nom → Copier l'identifiant.
DISCORD_USER_ID=""
# Prix du produit dans Maketou (hors frais), repris dans le message de vente par carte.
MAKETOU_MONTANT="75 435 FCFA"

# --- Après un paiement confirmé : code d'accès affiché et lien pour rejoindre ---
ACCESS_CODE=""
COMMUNITY_URL=""
