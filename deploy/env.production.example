# ===== Creato : réglages du serveur =====
# Ce fichier devient /opt/creato/.env sur le serveur. Il ne va JAMAIS sur GitHub.
# Les lignes marquées (auto) sont remplies par install.sh.

# Nom de domaine (sans https://)
DOMAIN="creatoskills.site"
APP_URL="https://creatoskills.site"
APP_TIMEZONE="Europe/Paris"

# (auto) Mot de passe de la base et secret des sessions
POSTGRES_PASSWORD=""
SESSION_SECRET=""

# Discord : Developer Portal → ton application
DISCORD_CLIENT_ID="1555281620469157999"
# OAuth2 → Reset Secret (le NOUVEAU, pas celui envoyé dans la conversation)
DISCORD_CLIENT_SECRET=""
# Bot → Reset Token (le NOUVEAU)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID="1538598086589550604"
DISCORD_ROLE_TIKTOK_ID="1539957105560260738"
DISCORD_ROLE_ELITE_ID="1540797992360218674"
ADMIN_DISCORD_IDS="1380874416896086016"

# IA : lecture des captures de résultats par Claude (console.anthropic.com → API Keys)
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
# Lectures de captures par l'IA et par mois (au-delà : vérification à la main)
AI_MONTHLY_MAX_READS="300"

# Toujours false en production
DEV_LOGIN_ENABLED="false"
