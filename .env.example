DATABASE_URL="postgresql://postgres@127.0.0.1:5433/creato"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/creato_test"
SESSION_SECRET="(générer avec: openssl rand -hex 32)"
# Connexion de démonstration, à laisser à false en production
DEV_LOGIN_ENABLED="false"
# Adresse publique du site (sans / final)
APP_URL="http://localhost:3000"
# Discord Developer Portal → ton application → OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Identifiants (mode développeur Discord → clic droit → Copier l'identifiant)
DISCORD_GUILD_ID="1538598086589550604"
DISCORD_ROLE_TIKTOK_ID="1539957105560260738"
DISCORD_ROLE_ELITE_ID="1540797992360218674"
# Discord Developer Portal → Bot → Reset Token (sert à revérifier le rôle @TikTok et donner @Élite)
DISCORD_BOT_TOKEN=""
# Identifiants Discord des administrateurs, séparés par des virgules
ADMIN_DISCORD_IDS="1380874416896086016"
# Dossier où sont stockés les fichiers envoyés (chemin absolu en production)
STORAGE_DIR="./storage"
# IA : "gemini" en production, "mock" (IA simulée) en développement
AI_PROVIDER="mock"
GEMINI_API_KEY=""
# Modèles (le plus précis disponible) et images analysées par seconde de vidéo
GEMINI_ANALYST_MODEL="gemini-2.5-pro"
GEMINI_GRADER_MODEL="gemini-2.5-pro"
GEMINI_VIDEO_FPS="2"
# Fuseau par défaut (rappels des élèves qui ne l'ont pas encore donné, résumés des coachs)
APP_TIMEZONE="Europe/Paris"
