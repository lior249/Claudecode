// Creato Learn — schéma de données.
// Règles : docs/SPEC.md + docs/DECISIONS.md (prioritaire).
// Le verrouillage des leçons n'est jamais stocké : il est dérivé des validations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  LEARNER
}

enum UserStatus {
  ACTIVE
  REVOKED // a perdu le rôle Discord @TikTok
}

// Rangs saisis à la main par le coach (A à SSS dépendent de TikTok).
// E à B sont calculés depuis la progression.
enum ManualRank {
  A
  S
  SS
  SSS
}

enum LessonType {
  UNDERSTANDING // Compréhension : QCM de 20 questions
  DECISION // Décision : choix d'une fiche dans un catalogue
  PRACTICE_AI // Pratique corrigée par l'IA
  PRACTICE_HUMAN // Pratique validée par le coach
  CODE_VALIDATION // Phrase + code secret (niveau Lancement)
}

model User {
  id              String      @id @default(cuid())
  discordUserId   String?     @unique
  discordUsername String?
  displayName     String
  avatarUrl       String?
  role            Role        @default(LEARNER)
  status          UserStatus  @default(ACTIVE)
  manualRank      ManualRank?

  // Coachs : ordre de remplissage et capacité (20 élèves par défaut).
  coachOrder    Int?
  coachCapacity Int  @default(20)

  // Élève : coach attribué.
  coachId  String?
  coach    User?   @relation("CoachLearners", fields: [coachId], references: [id], onDelete: SetNull)
  learners User[]  @relation("CoachLearners")

  // Dernière vérification du rôle @TikTok (à la connexion, puis toutes les heures via le bot).
  lastRoleCheckAt DateTime?

  learnStartedAt   DateTime?
  learnCompletedAt DateTime?
  eliteGrantedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]
  submissions  Submission[]
  assets       Asset[]
  auditLogs    AuditLog[]

  @@index([coachId])
}

model Session {
  id        String   @id // hash SHA-256 du jeton (jamais le jeton en clair)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Level {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  position    Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  title       String
  description String   @default("")
  position    Int
  isPublished Boolean  @default(true)
  whopUrl     String? // lien d'accès secret, révélé seulement quand le module est débloqué
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@index([levelId, position])
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  title       String
  summary     String     @default("") // consigne courte affichée à l'élève
  type        LessonType
  position    Int
  isPublished Boolean    @default(true)
  // Paramètres propres au type (barème texte, seuil, catalogue…). Jamais envoyés tels quels au navigateur.
  config      Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  submissions   Submission[]
  assets        Asset[]

  @@index([moduleId, position])
}

// Une ligne par leçon validée (ou en cours de tentatives). Une validation acquise reste acquise.
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  attemptCount Int       @default(0)
  bestScore    Float?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// --- Compréhension (QCM) ---

enum QuizChoice {
  A
  B
  C
  D
}

model QuizQuestion {
  id            String     @id @default(cuid())
  lessonId      String
  lesson        Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position      Int // 1 à 20
  question      String
  answerA       String
  answerB       String
  answerC       String
  answerD       String
  correctAnswer QuizChoice
  explanation   String     @default("")
  updatedAt     DateTime   @updatedAt

  @@unique([lessonId, position])
}

model QuizAttempt {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  totalQuestions Int
  score          Int?
  passed         Boolean?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  answers        QuizAnswer[]

  @@index([userId, lessonId])
}

// Chaque réponse garde une copie de la question : l'historique survit aux modifications de l'Admin.
model QuizAnswer {
  id             String      @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  position       Int
  questionId     String? // peut disparaître si l'Admin supprime la question
  questionText   String
  selectedAnswer QuizChoice
  correctAnswer  QuizChoice
  isCorrect      Boolean
  answeredAt     DateTime    @default(now())

  @@unique([attemptId, position])
}

// --- Pratique (soumissions) ---

enum AssetKind {
  VIDEO
  AUDIO
  IMAGE
}

enum SubmissionStatus {
  PROCESSING // en file d'attente / en cours d'analyse
  PASSED // note >= seuil
  FAILED // note < seuil
  ERROR // panne technique (IA, analyse) : peut être relancée
  PENDING_HUMAN // l'élève a fait appel à un humain
  HUMAN_APPROVED
  HUMAN_REJECTED
}

// Fichier envoyé. Supprimer le fichier (deletedAt) ne supprime jamais la ligne : le hash et les métadonnées restent.
model Asset {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson      @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  submissionId    String?
  submission      Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  kind            AssetKind
  storageKey      String      @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  sha256          String
  durationSeconds Float?
  width           Int?
  height          Int?
  hasAudio        Boolean?
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?

  @@index([userId, lessonId])
  @@index([sha256])
}

model Submission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  attemptNumber     Int
  status            SubmissionStatus @default(PROCESSING)
  text              String?
  textSha256        String?
  score             Float?
  threshold         Float
  criteria          Json? // [{ name, maxPoints, pointsLost, comment, source: "MEASURE" | "AI" }]
  feedback          String?
  measurements      Json?
  aiModel           String?
  technicalFailures Int              @default(0)
  lastError         String? // détail technique (jamais montré à l'élève)
  createdAt         DateTime         @default(now())
  processedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewComment     String?
  assets            Asset[]

  @@unique([userId, lessonId, attemptNumber])
  @@index([lessonId, status])
}

// --- File de tâches (traitées par le worker, jamais dans une requête HTTP) ---

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}
