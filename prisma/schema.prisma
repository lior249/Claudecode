// Creato Learn — schéma de données.
// Règles : docs/SPEC.md + docs/DECISIONS.md (prioritaire).
// Le verrouillage des leçons n'est jamais stocké : il est dérivé des validations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  LEARNER
}

enum UserStatus {
  ACTIVE
  REVOKED // a perdu le rôle Discord @TikTok
}

// Rangs saisis à la main par le coach (A à SSS dépendent de TikTok).
// E à B sont calculés depuis la progression.
enum CoachingStatus {
  NONE // pas encore en coaching
  ACTIVE
  REVOKED // absence de plus de 15 jours
  COMPLETED // rang SSS atteint
}

enum ManualRank {
  A
  S
  SS
  SSS
}

enum LessonType {
  UNDERSTANDING // Compréhension : QCM de 20 questions
  DECISION // Décision : choix d'une fiche dans un catalogue
  PRACTICE_AI // Pratique corrigée par l'IA
  PRACTICE_HUMAN // Pratique validée par le coach
  CODE_VALIDATION // Phrase + code secret (niveau Lancement)
}

model User {
  id              String      @id @default(cuid())
  discordUserId   String?     @unique
  discordUsername String?
  displayName     String
  avatarUrl       String? // photo Discord (mise à jour à chaque connexion)
  photoKey        String? // photo choisie sur Creato (remplace la photo Discord)
  role            Role        @default(LEARNER)
  status          UserStatus  @default(ACTIVE)
  manualRank      ManualRank?

  // Coachs : ordre de remplissage et capacité (20 élèves par défaut).
  coachOrder    Int?
  coachCapacity Int  @default(20)

  // Élève : coach attribué.
  coachId  String?
  coach    User?   @relation("CoachLearners", fields: [coachId], references: [id], onDelete: SetNull)
  learners User[]  @relation("CoachLearners")

  // Dernière vérification du rôle @TikTok (à la connexion, puis toutes les heures via le bot).
  lastRoleCheckAt DateTime?

  // Coaching (après le rôle @Élite).
  coachingStatus    CoachingStatus @default(NONE)
  coachingStartedAt DateTime?
  coachingEndedAt   DateTime?
  tiktokUsername    String? // sans @, pour vérifier les liens des posts
  timezone          String? // fuseau IANA de l'élève (ex. "Africa/Abidjan")
  coachStars        Int            @default(3) // coachs : de 1 à 6
  coachFastAnswers  Int            @default(0) // réponses en moins d'1 h (toutes les 10 : +1 étoile)

  learnStartedAt   DateTime?
  learnCompletedAt DateTime?
  eliteGrantedAt   DateTime?

  // Notifications : heure du rappel quotidien (heure locale), messages privés Discord, dernière visite.
  reminderHour Int       @default(19)
  dmEnabled    Boolean   @default(true)
  lastSeenAt   DateTime?

  // Coach : dernière mise à jour de ses disponibilités de la semaine.
  availabilityUpdatedAt DateTime?

  onboardedAt      DateTime? // accueil en 4 étapes terminé
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  progress         LessonProgress[]
  quizAttempts     QuizAttempt[]
  submissions      Submission[]
  assets           Asset[]
  decisions        DecisionResponse[]
  launchReports    LaunchReport[]
  ticketsAsLearner Ticket[]              @relation("TicketLearner")
  ticketsAsCoach   Ticket[]              @relation("TicketCoach")
  ticketMessages   TicketMessage[]
  posts            Post[]
  reactivations    ReactivationRequest[] @relation("ReactivationLearner")
  auditLogs        AuditLog[]
  notifications    Notification[]
  resultPosts      ResultPost[]          @relation("ResultAuthor")
  postReactions    PostReaction[]
  availability     CoachAvailability[]

  @@index([coachId])
}

model Session {
  id        String   @id // hash SHA-256 du jeton (jamais le jeton en clair)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Level {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  position    Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  title       String
  description String   @default("")
  position    Int
  isPublished Boolean  @default(true)
  whopUrl     String? // lien d'accès secret, révélé seulement quand le module est débloqué
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@index([levelId, position])
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  title       String
  summary     String     @default("") // consigne courte affichée à l'élève
  type        LessonType
  position    Int
  isPublished Boolean    @default(true)
  // Paramètres propres au type (barème texte, seuil, catalogue…). Jamais envoyés tels quels au navigateur.
  config      Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  submissions   Submission[]
  assets        Asset[]
  decisions     DecisionResponse[]
  launchReports LaunchReport[]

  @@index([moduleId, position])
}

// Une ligne par leçon validée (ou en cours de tentatives). Une validation acquise reste acquise.
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  attemptCount Int       @default(0)
  bestScore    Float?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// --- Compréhension (QCM) ---

enum QuizChoice {
  A
  B
  C
  D
}

model QuizQuestion {
  id            String     @id @default(cuid())
  lessonId      String
  lesson        Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position      Int // 1 à 20
  question      String
  answerA       String
  answerB       String
  answerC       String
  answerD       String
  correctAnswer QuizChoice
  explanation   String     @default("")
  updatedAt     DateTime   @updatedAt

  @@unique([lessonId, position])
}

model QuizAttempt {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  totalQuestions Int
  score          Int?
  passed         Boolean?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  answers        QuizAnswer[]

  @@index([userId, lessonId])
}

// Chaque réponse garde une copie de la question : l'historique survit aux modifications de l'Admin.
model QuizAnswer {
  id             String      @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  position       Int
  questionId     String? // peut disparaître si l'Admin supprime la question
  questionText   String
  selectedAnswer QuizChoice
  correctAnswer  QuizChoice
  isCorrect      Boolean
  answeredAt     DateTime    @default(now())

  @@unique([attemptId, position])
}

// --- Pratique (soumissions) ---

enum AssetKind {
  VIDEO
  AUDIO
  IMAGE
}

enum SubmissionStatus {
  PROCESSING // en file d'attente / en cours d'analyse
  PASSED // note >= seuil
  FAILED // note < seuil
  ERROR // panne technique (IA, analyse) : peut être relancée
  PENDING_HUMAN // l'élève a fait appel à un humain
  HUMAN_APPROVED
  HUMAN_REJECTED
}

// Fichier envoyé. Supprimer le fichier (deletedAt) ne supprime jamais la ligne : le hash et les métadonnées restent.
model Asset {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson      @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  submissionId    String?
  submission      Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  kind            AssetKind
  storageKey      String      @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  sha256          String
  durationSeconds Float?
  width           Int?
  height          Int?
  hasAudio        Boolean?
  // Fichier de référence d'un exercice (envoyé par l'Admin), jamais supprimé par le ménage.
  isReference     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?

  @@index([userId, lessonId])
  @@index([sha256])
}

model Submission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  attemptNumber     Int
  status            SubmissionStatus @default(PROCESSING)
  text              String?
  textSha256        String?
  score             Float?
  threshold         Float
  criteria          Json? // CriterionResult[] : erreurs comptées par critère, points retirés calculés par le serveur
  // Critères tels qu'ils étaient au moment de l'envoi (l'Admin peut les modifier ensuite).
  criteriaSnapshot  Json?
  analysis          Json? // rapport d'analyse complet (mesures + description de l'analyste)
  feedback          String?
  aiModel           String? // modèles utilisés (analyste / correcteur)
  technicalFailures Int              @default(0)
  lastError         String? // détail technique (jamais montré à l'élève)
  createdAt         DateTime         @default(now())
  processedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewComment     String?
  assets            Asset[]

  @@unique([userId, lessonId, attemptNumber])
  @@index([lessonId, status])
}

// --- File de tâches (traitées par le worker, jamais dans une requête HTTP) ---

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}

// --- Décisions (niveau 2) : catalogues remplis par l'Admin ---

enum Catalog {
  NICHE
  COUNTRY
  METHOD_10K
}

model CatalogItem {
  id           String             @id @default(cuid())
  catalog      Catalog
  title        String
  summary      String             @default("") // phrase d'accroche affichée dans la liste
  body         String             @default("") // contenu complet de la fiche
  thumbnailKey String? // image (clé de stockage)
  imageKeys    Json               @default("[]") // photos de la fiche
  links        Json               @default("[]") // [{ label, url }]
  position     Int                @default(0)
  isPublished  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  choices      DecisionResponse[]
  options      CatalogItemOption[]

  @@index([catalog, position])
}

// Critères d'un catalogue (ex. « Concurrence ») et leurs options (ex. « Faible »), définis par l'admin.
model CatalogCriterion {
  id        String          @id @default(cuid())
  catalog   Catalog
  label     String
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  options   CatalogOption[]

  @@index([catalog, position])
}

model CatalogOption {
  id          String              @id @default(cuid())
  criterionId String
  criterion   CatalogCriterion    @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  label       String
  color       String              @default("gray") // gray, green, yellow, red, blue, purple
  position    Int                 @default(0)
  items       CatalogItemOption[]

  @@index([criterionId, position])
}

// Option retenue pour une fiche (une par critère au maximum).
model CatalogItemOption {
  itemId   String
  item     CatalogItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  optionId String
  option   CatalogOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([itemId, optionId])
  @@index([optionId])
}

// Choix d'un élève pour une leçon Décision : un seul, définitif.
model DecisionResponse {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  // Copie du titre au moment du choix (la fiche peut être modifiée ensuite).
  itemTitle     String
  chosenAt      DateTime    @default(now())

  @@unique([userId, lessonId])
}

// --- Lancement (niveau 3) : rapport envoyé au coach ---

model LaunchReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  answers     Json // [{ question, answer }]
  submittedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// Rappels déjà envoyés (chaque rappel ne part qu'une fois).
enum DmStatus {
  PENDING // à envoyer (le worker attend la fin des heures calmes)
  SENT
  SKIPPED // pas de message privé (plafond du jour, désactivé, trop ancien)
  FAILED
}

// Centre de notifications (cloche) + message privé Discord envoyé par le worker.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // ex. "streak.risk", "coach.digest"
  text      String
  href      String?
  mood      String    @default("neutre") // expression de la mascotte (public/mascotte/<mood>.png)
  urgent    Boolean   @default(false) // ignore les heures calmes et le plafond quotidien
  dmStatus  DmStatus  @default(PENDING)
  dmSentAt  DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([dmStatus, createdAt])
}

model Reminder {
  id     String   @id @default(cuid())
  userId String
  key    String // ex. "deadline4h:<lessonId>"
  sentAt DateTime @default(now())

  @@unique([userId, key])
}

// --- Coaching ---

enum TicketOrigin {
  LEARNER // demande de l'élève (délai de 12 h pour le coach)
  COACH // ticket de suivi (question prédéfinie)
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketRating {
  BAD
  NEUTRAL
  GOOD
}

enum MessageKind {
  TEXT
  ACK // « Conseil reçu, je l'applique »
  OUTCOME // retour de l'élève : ça a marché ou pas
}

model Ticket {
  id            String          @id @default(cuid())
  learnerId     String
  learner       User            @relation("TicketLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  coachId       String
  coach         User            @relation("TicketCoach", fields: [coachId], references: [id], onDelete: Restrict)
  origin        TicketOrigin
  subject       String
  templateKey   String?
  status        TicketStatus    @default(OPEN)
  createdAt     DateTime        @default(now())
  closedAt      DateTime?
  rating        TicketRating?
  ratingComment String?
  ratedAt       DateTime?
  messages      TicketMessage[]
  waits         ResponseWait[]

  @@index([learnerId, status])
  @@index([coachId, status])
}

model TicketMessage {
  id             String      @id @default(cuid())
  ticketId       String
  ticket         Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind           MessageKind @default(TEXT)
  body           String
  imageKeys      Json        @default("[]")
  // Réponse du coach : délai dans lequel l'élève doit revenir (heures).
  followUpHours  Int?
  acknowledgedAt DateTime? // l'élève a cliqué « Conseil reçu »
  outcomeDueAt   DateTime? // date à laquelle l'élève doit dire si ça a marché
  outcome        String? // WORKED | DIDNT_WORK
  createdAt      DateTime    @default(now())

  @@index([ticketId, createdAt])
}

// Attente d'une réponse du coach (messages de l'élève dans ses tickets) : délai de 12 h et étoiles.
model ResponseWait {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  coachId    String
  askedAt    DateTime
  dueAt      DateTime
  answeredAt DateTime?
  late       Boolean   @default(false) // délai dépassé (compté une seule fois)
  lateWeek   String? // semaine du retard, ex. "2026-W40"
  fast       Boolean   @default(false) // réponse en moins d'une heure

  @@index([coachId, answeredAt])
  @@index([answeredAt, dueAt])
}

// Historique des étoiles d'un coach.
model CoachStarEvent {
  id        String   @id @default(cuid())
  coachId   String
  delta     Int
  stars     Int // valeur après changement
  reason    String
  createdAt DateTime @default(now())

  @@index([coachId, createdAt])
}

// Post TikTok déclaré par l'élève (streak et qualité).
model Post {
  id             String      @id @default(cuid())
  learnerId      String
  learner        User        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  url            String
  videoId        String
  postedAt       DateTime // lu dans l'identifiant de la vidéo
  localDate      String // jour du post dans le fuseau de l'élève (AAAA-MM-JJ)
  createdAt      DateTime    @default(now())

  @@unique([learnerId, videoId])
  @@index([learnerId, localDate])
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}




model ReactivationRequest {
  id          String      @id @default(cuid())
  learnerId   String
  learner     User        @relation("ReactivationLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  reason      String
  status      ProofStatus @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime    @default(now())
}

// --- Posts de résultats (mur des réussites) ---

// Post libre : titre, capture, texte, lien. Validé par le coach de l'élève, par l'admin pour un coach ;
// les posts de l'admin sont validés d'office. N'entre pas dans les revenus du mois.
// Chiffre lu sur une capture, qui peut décider des points (paliers) et des rangs spéciaux.
enum ResultMetric {
  NONE
  VIEWS
  REVENUE_EUR
  FOLLOWERS
}

// Types aux règles spéciales : revenus du mois (rangs S / SS / SSS, total, meilleur mois) et 10 000 abonnés (rang A).
enum ResultSpecial {
  NONE
  MONTHLY_REVENUE
  FOLLOWERS_RANK
}

// Type de résultat défini par l'admin : consigne, exemple, règles de lecture pour l'IA et points.
model ResultType {
  id            String        @id @default(cuid())
  name          String
  instructions  String        @default("") // consigne affichée à l'élève
  exampleKey    String? // image d'exemple (clé de stockage)
  aiMustHave    String        @default("") // ce que l'IA doit trouver sur la capture
  aiMustNotHave String        @default("") // ce que l'IA ne doit absolument pas trouver
  aiIdentifier  String        @default("") // ce qui identifie le résultat (ex. date de publication) : une seule fois par élève
  points        Int           @default(1) // points fixes
  metric        ResultMetric  @default(NONE) // chiffre lu (paliers facultatifs)
  tiers         Json          @default("[]") // [{ min, points }] : si non vide, remplace les points fixes
  special       ResultSpecial @default(NONE)
  position      Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  posts         ResultPost[]

  @@index([isActive, position])
}

enum ResultStatus {
  ANALYZING // lecture par l'IA en cours (worker)
  PENDING // à vérifier par un coach ou l'admin
  APPROVED
  REJECTED
}

model ResultPost {
  id            String         @id @default(cuid())
  authorId      String
  author        User           @relation("ResultAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  typeId        String
  type          ResultType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title         String
  body          String         @default("")
  imageKey      String
  imageSha256   String
  link          String?
  dailyCode     String // code du jour à écrire sur la capture
  month         String? // revenus du mois : mois concerné (AAAA-MM)
  status        ResultStatus   @default(ANALYZING)
  metricValue   Int? // chiffre lu (ou corrigé par le coach)
  identifier    String? // identifiant lu (ex. date de publication de la vidéo)
  points        Int            @default(0) // points gagnés par ce résultat (calculés par le serveur)
  aiReport      Json? // verdict de l'IA (conforme, raisons, chiffre, code trouvé…)
  aiModel       String?
  reviewComment String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime       @default(now())
  reactions     PostReaction[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([typeId, status, createdAt])
}

enum ReactionKind {
  FIRE // 🔥
  ROCKET // 🚀
  ANGRY // 😡
  CRY // 😢
}

// Une seule réaction par membre et par post (modifiable).
model PostReaction {
  id        String       @id @default(cuid())
  postId    String
  post      ResultPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

// --- Disponibilités des coachs (hebdomadaires, dans le fuseau du coach) ---

model CoachAvailability {
  id      String @id @default(cuid())
  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  weekday Int // 0 = lundi … 6 = dimanche
  start   String // "21:00"
  end     String // "23:00"

  @@index([coachId])
}


// Réglages de l'application (clé → valeur), ex. la vidéo d'accueil.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
