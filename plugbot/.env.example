# Copier ce fichier en .env puis remplir chaque ligne.
# Pour copier un identifiant (ID) sur Discord : Paramètres > Avancés > Mode développeur,
# puis clic droit sur le serveur, le salon, le rôle ou le membre > Copier l'identifiant.

# Jeton secret du bot (portail développeur Discord > Bot > Reset Token). Ne jamais le partager.
DISCORD_TOKEN=

# Le serveur Discord
GUILD_ID=

# Les salons
RESULTS_CHANNEL_ID=        # 🎮 flex-resultats
SHOWUP_CHANNEL_ID=         # ➕ show-up
WEEK_CHANNEL_ID=           # 💸 top-7
MONTH_CHANNEL_ID=          # 💎 top-30
PRISON_CHANNEL_ID=         # 🤢 la-prison
ALLTIME_CHANNEL_ID=        # top-all-time (facultatif)

# Planification des événements (facultatif : laisser vide pour la désactiver)
PLANNING_CHANNEL_ID=       # salon privé de création des événements
PLANNING_REMINDER_CHANNEL_ID= # salon privé des rappels pour planifier
ANNOUNCE_FREE_CHANNEL_ID=  # annonces free
ANNOUNCE_PLUG_CHANNEL_ID=  # annonces accompagnement

# Salons seulement mentionnés dans les messages
BONUS_WEEK_CHANNEL_ID=     # bonus-top7
BONUS_MONTH_CHANNEL_ID=    # bonus-top30
BONUS_STREAK_CHANNEL_ID=   # bonus-21j
GUIDE_CHANNEL_ID=          # guide-serveur

# Les rôles
FREE_ROLE_ID=              # Free
PLUG_ROLE_ID=              # TikTok (l'accompagnement)
STREAK_ROLE_ID=            # 🔥🔥🔥
WEEK_WINNER_ROLE_ID=       # ⚡plug7⚡
MONTH_WINNER_ROLE_ID=      # ★plug30★
PRISONER_ROLE_ID=          # 💔Prisonnier💔

# Identifiant de ton compte Discord : toi seul peux retirer des points avec ❌.
# Plusieurs admins possibles, séparés par des virgules.
ADMIN_USER_IDS=

# Nombre de jours d'affilée pour recevoir 🔥🔥🔥.
STREAK_ROLE_DAYS=21
