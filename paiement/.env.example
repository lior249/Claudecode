# Réglages d'Overmaxx (site de paiement + Bob). Sur le serveur : /opt/overmaxx/paiement/overmaxx.env
# Ne commite JAMAIS le vrai fichier.

# ---------- Site ----------
DOMAIN=overmaxx.online
# En local uniquement (sur le serveur, rempli automatiquement depuis DOMAIN) :
PORT=3000
BASE_URL=http://localhost:3000
NOM_FORMATION=Overmaxx
FICHIER_BASE=./data/paiement.db
DEVISE=XOF
PAYS=
CONTACT_SUPPORT=
LIEN_DISCORD=
# Généré automatiquement par deploy/overmaxx.sh. NE LE CHANGE JAMAIS ensuite.
APP_SECRET=

# ---------- Offres (prix en FCFA ; 1 € = 655,957 FCFA) ----------
# Chaque membre garde à vie le prix de renouvellement en vigueur à son inscription.
NOM_COMMUNITY=Overmaxx Community
PRIX_COMMUNITY_ENTREE=19025
PRIX_COMMUNITY_RENOUVELLEMENT=3280
DUREE_COMMUNITY_JOURS=30
# Jours « en attente » après la fin d'un accès Community non renouvelé, avant le retrait du serveur
ATTENTE_COMMUNITY_JOURS=15
NOM_ELITE=Overmaxx Elite
PRIX_ELITE_ENTREE=327980
PRIX_ELITE_RENOUVELLEMENT=39360
DUREE_ELITE_JOURS=90

# Vidéos Wistia (fin de l'URL wistia.com/medias/XXXXXXXXXX) et formulaire Tally (fin de tally.so/r/XXXXXX)
WISTIA_GUIDE_COMMUNITY=
WISTIA_GUIDE_ELITE=
WISTIA_VSL_ELITE=
# Paiement par carte après validation : lien de l'offre Whop cachée (même prix). Déjà réglé par défaut.
LIEN_CARTE_ELITE=
TALLY_FORM_ID=
# Secret de signature du webhook Tally (facultatif mais recommandé)
TALLY_SIGNING_SECRET=
# Taille maximale de la vidéo de candidature (Mo)
VIDEO_MAX_MO=20

# ---------- SasPay (LIVE) ----------
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

# ---------- Whop (LIVE) ----------
WHOP_API_URL=https://api.whop.com/api/v1
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Offres GRATUITES, cachées, en liste d'attente, avec la question « email de paiement »
WHOP_COMMUNITY_PLAN_ID=
WHOP_ELITE_PLAN_ID=

# ---------- Discord (Bob) ----------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ID=
DISCORD_ROLE_COMMUNITY=
DISCORD_ROLE_ELITE=
DISCORD_ROLE_GOAT=
# Rôle « Attente » : candidats Elite et membres Community en attente de renouvellement (un seul salon visible)
DISCORD_ROLE_ATTENTE=
# Nouveaux venus « En Attente » sans programme : retirés du serveur après ce nombre d'heures (0 = jamais)
ATTENTE_NOUVEAUX_HEURES=0
# Lien du salon vocal fixe de coaching (clic droit sur le salon → Copier le lien)
DISCORD_SALON_COACHING_URL=
# Salon d'attente existant (identifiant). Vide : Bob crée #en-attente tout seul au démarrage.
DISCORD_SALON_ATTENTE_ID=

# ---------- Email (facultatif, via resend.com) ----------
RESEND_API_KEY=
EMAIL_EXPEDITEUR=
