# Copie ce fichier en .env (en local) ou mets ces variables chez ton hébergeur.
# Ne commite JAMAIS le vrai .env.

PORT=3000
# URL publique de ce serveur (sans / à la fin). Sert pour le retour après paiement.
BASE_URL=https://paiement.example.com
NOM_FORMATION=Ma formation
# Prix demandé sur SasPay, dans la devise ci-dessous.
PRIX=25000
DEVISE=XOF
# Optionnel : présélectionne le pays sur la page de paiement (ex : BJ, CI, SN, CM).
PAYS=
CONTACT_SUPPORT=
# Chaîne aléatoire d'au moins 32 caractères (signe les cookies et génère les codes).
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- SasPay --- (sandbox par défaut ; production : https://api.saspay.me/api/v1)
SASPAY_API_URL=https://sandbox-api.saspay.me/api/v1
SASPAY_API_KEY=
# Secret de signature affiché UNE SEULE FOIS à la création du webhook dans le dashboard.
SASPAY_WEBHOOK_SECRET=

# --- Whop --- (sandbox par défaut ; production : https://api.whop.com/api/v1)
WHOP_API_URL=https://sandbox-api.whop.com/api/v1
WHOP_API_KEY=
WHOP_API_VERSION=2026-07-01
# Identifiant de ton entreprise Whop (biz_...)
WHOP_COMPANY_ID=
# Identifiant de l'offre payante et cachée (plan_...)
WHOP_PLAN_ID=
# Devise de cette offre sur Whop (ex : usd, eur, xof)
WHOP_DEVISE_OFFRE=usd
# Optionnel : lien d'achat de l'offre. Sinon il est lu via l'API.
WHOP_LIEN_ACHAT=

# --- Email (optionnel, via resend.com) ---
RESEND_API_KEY=
EMAIL_EXPEDITEUR=Formation <acces@ton-domaine.com>
